# PostgreSQL
POSTGRES_DB=tenders
POSTGRES_USER=tenders
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# First administrator account, created at startup when no account exists
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-with-12-characters-min
BOOTSTRAP_ADMIN_NAME=Administrateur

# Set to true when the application is served over HTTPS
SESSION_COOKIE_SECURE=false

# Port of the web interface
APP_PORT=3000

# Price of the AI model in euros per million tokens, to show the cost of each
# analysis (0 = cost not shown)
ANALYSIS_INPUT_PRICE=0
ANALYSIS_OUTPUT_PRICE=0

# Daily backup: folder on the host (to be copied off the server), time
# (Paris) and number of days kept
BACKUP_DIR=./backups
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=14

# Sources not collected (default: APPROCH,AWS). Remove AWS to collect
# marches-publics.info, within the written confirmation of AW Solutions.
#COLLECT_DISABLED_SOURCES=APPROCH,AWS
# Limits of the reading of marches-publics.info: natures (T works, S services,
# F supplies), pause before each page, pages per hour and per 24 hours.
#AW_SOLUTIONS_NATURES=T
#AW_SOLUTIONS_PAUSE=40s
#AW_SOLUTIONS_MAX_PAGES_PER_HOUR=90
#AW_SOLUTIONS_MAX_PAGES_PER_DAY=450
